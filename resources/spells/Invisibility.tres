[gd_resource type="Resource" script_class="Spell" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/spells/Spell.gd" id="1_spell"]
[ext_resource type="Script" path="res://scripts/spells/SelfBuffDelivery.gd" id="2_delivery"]
[ext_resource type="Script" path="res://scripts/spells/InvisibilityEffect.gd" id="3_invis"]
[ext_resource type="Script" path="res://scripts/spells/SpellEffect.gd" id="4_spelleffect"]

[sub_resource type="Resource" id="Resource_delivery"]
script = ExtResource("2_delivery")

[sub_resource type="Resource" id="Resource_invis"]
script = ExtResource("3_invis")
duration = 5.0

[resource]
script = ExtResource("1_spell")
id = "invisibility"
display_name = "隱形術"
description = "施放後自身隱形，持續5秒。隱形期間敵人完全無法定位你的位置，既有攻擊不會鎖定你。施放任意法術會立即中斷隱形效果。"
cast_time = 2.0
max_range = 0.0
slot_cost = 2
delivery = SubResource("Resource_delivery")
base_effects = Array[ExtResource("4_spelleffect")]([SubResource("Resource_invis")])
